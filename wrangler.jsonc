{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "redtape",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "redtape",
      "database_id": "7c4e2f91-8b3a-4d5e-9f10-a2b3c4d5e6f7",
      "migrations_dir": "migrations"
    }
  ],
  // Every minute: move each unfinished comparison forward, so a comparison finishes when nobody watches it.
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "PUBLIC_BASE_URL": "https://redtape.hamdanesmail12-7a9.workers.dev",
    // The site's screens answer only when this is "1". Off, every site path answers 404 and the
    // API keeps working. Set to "1" to put the site live.
    "SITE_ENABLED": "0"
  },
  // Styles and icons, served before the Worker runs. No .html file lives here.
  "assets": { "directory": "./public" },
  "preview_urls": true,
  "observability": {
    "enabled": true
  }
}
